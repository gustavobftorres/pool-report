# Balancer API Configuration

# Option 1: Use the unified Balancer GraphQL endpoint (recommended if you have one)
# This endpoint should work for both V2 and V3 pools
# Example: https://api.balancer.fi/graphql or your custom endpoint
BALANCER_GQL_ENDPOINT=

# Option 2: Use separate V2 and V3 endpoints (fallback)
# These are used if BALANCER_GQL_ENDPOINT is not set
BALANCER_V3_API=https://api-v3.balancer.fi/
BALANCER_V2_SUBGRAPH=https://api.thegraph.com/subgraphs/name/balancer-labs/balancer-v2

# Chain Configuration
DEFAULT_CHAIN=MAINNET

# Default Pool (optional)
DEFAULT_POOL_ADDRESS=0x3de27efa2f1aa663ae5d458857e731c129069f29


# Telegram Configuration (NEW)
# 1. Create bot via @BotFather to get TOKEN
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 2. Get your ID via @userinfobot to get CHAT_ID
TELEGRAM_CHAT_ID=your_chat_id_here

# Dune Analytics Configuration
# Get your API key from: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here
DUNE_QUERY_PERFORMANCE=medium  # Options: low, medium, high
DUNE_QUERY_TIMEOUT=60.0

DUNE_ANCHOR_VOLUME_QUERY_ID=6664013